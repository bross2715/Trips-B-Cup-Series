                <span style={{ width:50, textAlign:"right", fontWeight:900, fontStyle:"italic", color:x.fin<=5?"#5fe08a":x.fin<=10?"#e9edf2":"#9aa3b0" }}>{x.fin}</span>
                <span style={{ width:50, textAlign:"right", fontWeight:800 }}>{x.pts}</span>
              </div>
            ))}
          </div>

          <SectionLabel>Season 1 — Chase for the Kachow Cup</SectionLabel>
          <div style={{ background:"#11161e", border:"1px solid #1c242f", borderRadius:10, padding:"11px 13px" }}>
            <div style={{ display:"flex", alignItems:"center", gap:16 }}>
              <div>
                <div style={{ fontSize:24, fontWeight:900, fontStyle:"italic", color:"#f7c948", lineHeight:1 }}>{d.s1w}</div>
                <div style={{ fontSize:9.5, color:"#7b8493", fontWeight:700, marginTop:2, letterSpacing:0.3 }}>SEASON 1 WINS</div>
              </div>
              {d.honor && <span style={{ fontSize:10, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:5, padding:"4px 9px" }}>{d.honor}</span>}
            </div>
            {s1Wins.length > 0 ? (
              <div style={{ marginTop:12 }}>
                <div style={{ fontSize:9.5, letterSpacing:1, color:"#6b7484", fontWeight:800, marginBottom:7 }}>WON AT</div>
                <div style={{ display:"flex", flexWrap:"wrap", gap:6 }}>
                  {s1Wins.map(w => (
                    <span key={w.race} style={{ fontSize:11, fontWeight:700, background:"#0f141c", border:"1px solid #232c38", borderRadius:6, padding:"3px 8px" }}>{w.track} <span style={{ color:"#6b7484" }}>· R{w.race}</span></span>
                  ))}
                </div>
              </div>
            ) : (
              <div style={{ marginTop:10, fontSize:11, color:"#7b8493" }}>No Season 1 wins.</div>
            )}
            <div style={{ fontSize:10, color:"#5b6472", marginTop:12, lineHeight:1.5 }}>Full Season&nbsp;1 race-by-race finishes &amp; points coming soon — Season&nbsp;1 had no stage points.</div>
          </div>
        </div>
      </div>
    </div>
  );
}

function Tag({ children, gold }) {
  return <span style={{ fontSize:10, fontWeight:800, letterSpacing:0.5, padding:"2px 7px", borderRadius:5, background:gold?"#f7c948":"rgba(0,0,0,0.35)", color:gold?"#0a0d12":"#e9edf2", border:gold?"none":"1px solid rgba(255,255,255,0.2)" }}>{children}</span>;
}
function SectionLabel({ children }) {
  return <div style={{ fontSize:10, letterSpacing:1.5, color:"#6b7484", fontWeight:800, padding:"16px 2px 8px", textTransform:"uppercase" }}>{children}</div>;
}
function BigStat({ v, l, big }) {
  return (
    <div style={{ background:"#11161e", border:"1px solid #1c242f", borderRadius:9, padding:"9px 10px" }}>
      <div style={{ fontSize:big?26:20, fontWeight:900, fontStyle:"italic", letterSpacing:-0.5, color:big?"#f7c948":"#e9edf2", fontVariantNumeric:"tabular-nums", lineHeight:1 }}>{v}</div>
      <div style={{ fontSize:9.5, color:"#7b8493", fontWeight:700, marginTop:3, letterSpacing:0.3 }}>{l}</div>
    </div>
  );
}
function btn(disabled) {
  return { width:40, height:40, borderRadius:10, border:"1px solid #2a333f", background:disabled?"#161b22":"#1e2733", color:disabled?"#3a424d":"#e9edf2", fontSize:16, fontWeight:900, cursor:disabled?"default":"pointer", flexShrink:0 };
}
function StatCard({ label, d, sub, accent, placeholder, onSelect }) {
  return (
    <div onClick={()=>!placeholder && onSelect && onSelect(d.car)} style={{ background:"#11161e", border:"1px solid #1c242f", borderRadius:10, padding:"9px 11px", display:"flex", alignItems:"center", gap:9, minHeight:56, cursor:placeholder?"default":"pointer" }}>
      {placeholder ? <div style={{ width:38, height:38, borderRadius:8, background:"#1a212b", flexShrink:0 }} /> : <NumberChip d={d} size={38} />}
      <div style={{ minWidth:0 }}>
        <div style={{ fontSize:9, letterSpacing:1.2, color:"#7b8493", fontWeight:800 }}>{label}</div>
        <div style={{ fontSize:14, fontWeight:800, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{placeholder?"—":d.name}</div>
        <div style={{ fontSize:10, color:accent||"#8b94a3", fontWeight:700 }}>{sub}</div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(React.createElement(App));

  </script>
</body>
