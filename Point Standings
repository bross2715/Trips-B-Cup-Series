  const d = BY_CAR[car];
  const f = d.fin.map((x, i) => ({ race: i + 1, fin: x, pts: d.r[i] })).filter(x => x.fin > 0);
  const fins = f.map(x => x.fin);
  const s2w = seasonWins(car);
  const final = HISTORY[WINNERS.length - 1][car];
  return {
    d, log: f, starts: f.length,
    avg: fins.length ? (fins.reduce((a, b) => a + b, 0) / fins.length) : null,
    best: fins.length ? Math.min(...fins) : null,
    worst: fins.length ? Math.max(...fins) : null,
    t5: fins.filter(x => x <= 5).length,
    t10: fins.filter(x => x <= 10).length,
