function standingsAfter(ri) {
  const rows = DRIVERS.map(d => {
    let pts = 0, wins = 0, started = false;
    for (let i = 0; i <= ri; i++) {
      pts += d.r[i];
      if (d.r[i] > 0) started = true;
      if (WINNERS[i] === d.car) wins++;
    }
    return { ...d, pts, wins, started, gained: d.r[ri] };
  });
  rows.sort((a, b) => b.pts - a.pts || b.wins - a.wins || a.off - b.off);
  rows.forEach((row, i) => (row.rank = i + 1));
  return rows;
}
const HISTORY = Array.from({ length: WINNERS.length }, (_, i) => {
