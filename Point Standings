    <div style={{ background:"#11161e", border:"1px solid #1e2630", borderRadius:12, padding:"11px 13px", marginBottom:9 }}>
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"baseline" }}>
        <div style={{ fontSize:12, fontWeight:900, fontStyle:"italic", textTransform:"uppercase", letterSpacing:0.4 }}>{title}</div>
        {sub && <div style={{ fontSize:9, color:"#6b7484" }}>{sub}</div>}
      </div>
      <div style={{ display:"flex", flexDirection:"column", gap:6, marginTop:8 }}>
        {rows.map((r, i) => (
          <div key={r.d.car} onClick={() => onSelect(r.d.car)} style={{ display:"flex", alignItems:"center", gap:8, cursor:"pointer" }}>
            <span style={{ width:14, fontSize:11, fontWeight:900, color: i === 0 ? "#f7c948" : "#5b6472", fontStyle:"italic" }}>{i + 1}</span>
            <NumberChip d={r.d} size={i === 0 ? 30 : 24} />
            <span style={{ flex:1, fontSize: i === 0 ? 13 : 11, fontWeight: i === 0 ? 800 : 600, color: i === 0 ? "#e9edf2" : "#9aa2af", whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>
              {r.d.name}{r.d.status === "Human" && <span style={{ fontSize:7, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:3, padding:"1px 3px", marginLeft:5 }}>YOU</span>}
            </span>
            <span style={{ fontWeight:900, fontSize: i === 0 ? 16 : 12, fontVariantNumeric:"tabular-nums", color: i === 0 ? "#f7c948" : "#cdd4dd" }}>{fmt ? fmt(r.value) : r.value}</span>
          </div>
        ))}
      </div>
    </div>
  );
}
function Leaders({ onSelect }) {
  const rows = standingsAfter(WINNERS.length - 1).filter(d => d.started);
  const profiles = rows.map(d => ({ d, p: profileFor(d.car) }));
  const top = (sel, asc = false, n = 3) => {
    const arr = profiles.map(({ d, p }) => ({ d, value: sel(d, p) })).filter(x => x.value !== null && x.value !== undefined);
    arr.sort((a, b) => asc ? a.value - b.value : b.value - a.value);
    return arr.slice(0, n);
  };
  return (
    <div>
      <div style={{ background:"#11161e", border:"1px solid #1e2630", borderRadius:12, padding:"12px 14px", marginBottom:10 }}>
        <div style={{ fontSize:14, fontWeight:900, fontStyle:"italic", textTransform:"uppercase", letterSpacing:0.5 }}>League Leaders</div>
        <div style={{ fontSize:11, color:"#8b94a3", marginTop:5, lineHeight:1.5 }}>Through Race 14 · Tap any name for the full driver page.</div>
      </div>
      <LeaderCard title="Wins" rows={top((d, p) => p.s2w)} onSelect={onSelect} />
      <LeaderCard title="Stage Points" sub="10-9-8 scheme" rows={top(d => d.sp)} onSelect={onSelect} />
      <LeaderCard title="Most Laps Led Awards" rows={top(d => d.mll)} onSelect={onSelect} />
      <LeaderCard title="Top 5 Finishes" rows={top((d, p) => p.t5)} onSelect={onSelect} />
      <LeaderCard title="Top 10 Finishes" rows={top((d, p) => p.t10)} onSelect={onSelect} />
      <LeaderCard title="Best Average Finish" sub="lowest wins" rows={top((d, p) => p.avg, true)} onSelect={onSelect} fmt={v => v.toFixed(2)} />
      <LeaderCard title="Current Top-10 Streak" sub="active heading into R13" rows={top(d => top10Streak(d))} onSelect={onSelect} fmt={v => `${v} races`} />
    </div>
  );
}
function Insights({ onSelect }) {
  return <Leaders onSelect={onSelect} />;
}

function ChaseTracker({ onSelect }) {
  const s = standingsAfter(WINNERS.length - 1).filter(d => d.started);
  const SEED = [75, 60, 55, 50, 45, 40, 35, 30, 25, 20, 15, 10];
  const inField = s.slice(0, CHASE_FIELD);
  const nonChase = s.slice(CHASE_FIELD);
  const cutPts = inField.length ? inField[inField.length - 1].pts : 0;
  const peoplesPts = nonChase.length ? nonChase[0].pts : 0;

  const form = (d) => {
    const f = d.fin.filter(x => x > 0);
    const last = f.slice(-4);
    const r = last.reduce((a, b) => a + b, 0) / last.length;
    const sz = f.reduce((a, b) => a + b, 0) / f.length;
    const diff = sz - r;
    if (diff >= 3) return { t: "▲ HOT", c: "#22c55e" };
    if (diff <= -3) return { t: "▼ COOL", c: "#ef4444" };
    return { t: "STEADY", c: "#8b94a3" };
  };

  return (
    <>
      <div style={{ background:"#11161e", border:"1px solid #1e2630", borderRadius:12, padding:"12px 14px", marginBottom:10 }}>
        <div style={{ fontSize:14, fontWeight:900, fontStyle:"italic", textTransform:"uppercase", letterSpacing:0.5 }}>Chase / Playoff Tracker</div>
        <div style={{ fontSize:11, color:"#8b94a3", marginTop:5, lineHeight:1.55 }}>Top <b style={{color:"#cdd4dd"}}>12 on points</b> at Race 26 make the 10-race Chase (R27–36) — no win-and-in, no eliminations. At the cut, points <b style={{color:"#cdd4dd"}}>reset by seed</b> (75 / 60 / 55 / 50 / 45 / 40 / 35 / 30 / 25 / 20 / 15 / 10), then most points after Atlanta is champion. <b style={{color:"#f7c948"}}>Projection through Race 14.</b></div>
      </div>

      <SectionLabel>Projected Chase seeding — reset points</SectionLabel>
      <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
        {inField.map((d, i) => {
          const fm = form(d);
          const bubble = i === inField.length - 1;
          return (
            <div key={d.car} onClick={() => onSelect(d.car)} style={{ display:"flex", alignItems:"center", gap:9, padding:"7px 10px", background: d.status==="Human"?"linear-gradient(90deg,#1a2433,#11161e)":"#11161e", border:`1px solid ${d.status==="Human"?"#f7c94855":"#1c242f"}`, borderLeft:`4px solid ${d.cb}`, borderRadius:9, cursor:"pointer" }}>
              <span style={{ width:18, fontWeight:900, fontStyle:"italic", fontSize:15, textAlign:"center", color: i===0?"#f7c948":"#8b94a3" }}>{i + 1}</span>
              <NumberChip d={d} size={32} />
              <div style={{ flex:1, minWidth:0 }}>
                <div style={{ fontWeight:800, fontSize:14, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{d.name}{d.status==="Human" && <span style={{ fontSize:8, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:3, padding:"1px 4px", marginLeft:6 }}>YOU</span>}</div>
                <div style={{ fontSize:10, fontWeight:700, marginTop:1, display:"flex", gap:6, alignItems:"center" }}>
                  <span style={{ color:fm.c }}>{fm.t}</span>
                  <span style={{ color:"#7b8493" }}>{d.pts} pts{bubble ? " · BUBBLE" : ""}</span>
                </div>
              </div>
              <div style={{ textAlign:"right", flexShrink:0 }}>
                <div style={{ fontWeight:900, fontSize:19, color:"#f7c948", fontVariantNumeric:"tabular-nums", lineHeight:1 }}>{SEED[i]}</div>
                <div style={{ fontSize:8, color:"#6b7484", fontWeight:700, letterSpacing:0.5 }}>RESET</div>
              </div>
            </div>
          );
        })}
        <div style={{ display:"flex", alignItems:"center", gap:8, margin:"2px 0" }}>
          <div style={{ flex:1, borderBottom:"2px dashed #ef4444" }} />
          <span style={{ fontSize:9, fontWeight:900, color:"#ef4444", letterSpacing:1, whiteSpace:"nowrap" }}>CUT LINE · {cutPts} PTS</span>
          <div style={{ flex:1, borderBottom:"2px dashed #ef4444" }} />
        </div>
      </div>

      <SectionLabel>The People&apos;s Champ — best of the rest (P13+)</SectionLabel>
      <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
        {nonChase.slice(0, 8).map((d, i) => (
          <div key={d.car} onClick={() => onSelect(d.car)} style={{ display:"flex", alignItems:"center", gap:9, padding:"7px 10px", background: i===0?"linear-gradient(90deg,#2a230c,#11161e)":(d.status==="Human"?"linear-gradient(90deg,#1a2433,#11161e)":"#11161e"), border:`1px solid ${i===0?"#f7c948":"#1c242f"}`, borderLeft:`4px solid ${d.cb}`, borderRadius:9, cursor:"pointer" }}>
            <span style={{ width:24, fontWeight:900, fontStyle:"italic", fontSize:14, textAlign:"center", color:"#8b94a3" }}>{CHASE_FIELD + 1 + i}</span>
            <NumberChip d={d} size={32} />
            <div style={{ flex:1, minWidth:0 }}>
              <div style={{ fontWeight:800, fontSize:14, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{d.name}{d.status==="Human" && <span style={{ fontSize:8, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:3, padding:"1px 4px", marginLeft:6 }}>YOU</span>}</div>
              <div style={{ fontSize:10, color:"#7b8493", fontWeight:600 }}>{d.pts} pts{i>0 ? ` · ${peoplesPts - d.pts} back` : ""} · {cutPts - d.pts} from Chase</div>
            </div>
            {i === 0
              ? <span style={{ fontSize:9, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:4, padding:"3px 7px", letterSpacing:0.5, flexShrink:0 }}>PEOPLE&apos;S CHAMP</span>
              : <span style={{ fontSize:14, fontWeight:900, fontVariantNumeric:"tabular-nums", flexShrink:0 }}>{d.pts}</span>}
          </div>
        ))}
      </div>

      <div style={{ fontSize:10, color:"#5b6472", padding:"12px 6px 0", lineHeight:1.55 }}>Reset/Chase activates at Race 27 — this is a projection off the current 12 races. Three crowns tracked: the <b style={{color:"#8b94a3"}}>reset Chase champion</b> (here), the <b style={{color:"#8b94a3"}}>full-season points champion</b> with no reset (the main Tower), and the <b style={{color:"#f7c948"}}>People&apos;s Champ</b> for the best car outside the 12.</div>
    </>
  );
}

// Championship-rank movement caused by the 4-3-2 -> 10-9-8 stage re-score (through R12).
// [car, deltaSpots, oldRank, newRank]
const MOVERS = {
  up:   [["88",4,35,31],["19",3,21,18],["23",3,27,24],["5",2,11,9],["10",2,19,17]],
  down: [["43",-3,32,35],["35",-2,14,16],["22",-2,17,19],["21",-2,18,20],["54",-2,24,26]],
};
function StagePoints({ onSelect }) {
  const ranked = standingsAfter(WINNERS.length - 1).filter(d => d.started).sort((a, b) => b.sp - a.sp || b.sw - a.sw || a.off - b.off);
  const max = Math.max(1, ranked[0].sp);
  return (
    <>
      <div style={{ background:"#11161e", border:"1px solid #1e2630", borderRadius:12, padding:"12px 14px", marginBottom:10 }}>
        <div style={{ fontSize:14, fontWeight:900, fontStyle:"italic", textTransform:"uppercase", letterSpacing:0.5 }}>Stage Points Standings</div>
        <div style={{ fontSize:11, color:"#8b94a3", marginTop:5, lineHeight:1.55 }}>Stage points only — <b style={{color:"#cdd4dd"}}>10-9-8</b> scheme (top 3 each stage), applied to all races. Your <b style={{color:"#cdd4dd"}}>#15</b> and <b style={{color:"#cdd4dd"}}>#27</b> bank none by league rule, so they sit on the floor.</div>
      </div>
      <div style={{ background:"#11161e", border:"1px solid #1e2630", borderRadius:12, padding:"11px 13px", marginBottom:10 }}>
        <div style={{ fontSize:11, fontWeight:900, fontStyle:"italic", textTransform:"uppercase", letterSpacing:0.5, color:"#cdd4dd" }}>10-9-8 Rule-Change Impact</div>
        <div style={{ fontSize:10, color:"#7b8493", margin:"3px 0 8px" }}>Championship-rank shift vs the old 4-3-2 scheme, through Race 12.</div>
        {[["\u25B2 Climbed","#34d058",MOVERS.up],["\u25BC Slid","#ef5b5b",MOVERS.down]].map(([label,clr,list]) => (
          <div key={label} style={{ display:"flex", alignItems:"flex-start", gap:8, marginTop:7 }}>
            <span style={{ width:58, fontSize:10, fontWeight:800, color:clr, flexShrink:0, paddingTop:6 }}>{label}</span>
            <div style={{ display:"flex", gap:7, flexWrap:"wrap" }}>
              {list.map(([c,delta,o,n]) => { const dd = DRIVERS.find(x => x.car === c); return (
                <div key={c} onClick={() => onSelect(c)} style={{ display:"flex", alignItems:"center", gap:5, background:"#0c1118", border:"1px solid #1c242f", borderRadius:7, padding:"3px 7px 3px 3px", cursor:"pointer" }}>
                  <NumberChip d={dd} size={24} />
                  <span style={{ fontSize:11, fontWeight:800, color:clr, fontVariantNumeric:"tabular-nums" }}>{delta > 0 ? `+${delta}` : delta}</span>
                  <span style={{ fontSize:9, color:"#6b7480" }}>P{o}&rarr;{n}</span>
                </div>
              ); })}
            </div>
          </div>
        ))}
      </div>
      <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
        {ranked.map((d, i) => (
          <div key={d.car} onClick={() => onSelect(d.car)} style={{ display:"flex", alignItems:"center", gap:9, padding:"6px 10px", background: d.status==="Human"?"linear-gradient(90deg,#1a2433,#11161e)":"#11161e", border:`1px solid ${d.status==="Human"?"#f7c94855":"#1c242f"}`, borderLeft:`4px solid ${d.cb}`, borderRadius:9, cursor:"pointer", position:"relative", overflow:"hidden" }}>
            <div style={{ position:"absolute", left:0, top:0, bottom:0, width:`${(d.sp / max) * 100}%`, background:`${d.cb}22`, pointerEvents:"none" }} />
            <span style={{ width:22, fontWeight:900, fontStyle:"italic", color: i===0?"#f7c948":"#8b94a3", textAlign:"center", zIndex:1 }}>{i + 1}</span>
            <NumberChip d={d} size={32} />
            <div style={{ flex:1, minWidth:0, zIndex:1 }}>
              <div style={{ fontWeight:800, fontSize:14, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{d.name}{d.status==="Human" && <span style={{ fontSize:8, fontWeight:900, color:"#0a0d12", background:"#f7c948", borderRadius:3, padding:"1px 4px", marginLeft:6 }}>YOU</span>}</div>
              <div style={{ fontSize:10, color:"#7b8493" }}>{d.sw} stage {d.sw === 1 ? "win" : "wins"}</div>
            </div>
            <div style={{ fontWeight:900, fontSize:18, zIndex:1, fontVariantNumeric:"tabular-nums", color: d.sp ? "#e9edf2" : "#5b6472" }}>{d.sp}</div>
          </div>
        ))}
      </div>
      <div style={{ fontSize:10, color:"#5b6472", padding:"12px 6px 0" }}>Ranked by stage points; ties broken by stage wins. Tap a driver for full history.</div>
    </>
  );
}

function DriverDetail({ car, onClose }) {
  const p = profileFor(car);
  const d = p.d;
  const trend = useMemo(() => Array.from({ length:WINNERS.length }, (_,i) => {
    const h = HISTORY[i][car];
    return { race:`R${i+1}`, rank: h && h.started ? h.rank : null };
  }), [car]);
  const maxR = Math.max(2, ...trend.map(t=>t.rank||1));
  const s1Wins = S1_WINNERS.map((c, i) => (c === car ? { race: i + 1, track: S1_TRACKS[i] } : null)).filter(Boolean);
  return (
    <div onClick={onClose} style={{ position:"fixed", inset:0, background:"rgba(4,6,10,0.78)", zIndex:50, display:"flex", justifyContent:"center", alignItems:"flex-start", padding:"12px", overflowY:"auto" }}>
      <div onClick={e=>e.stopPropagation()} style={{ width:"100%", maxWidth:560, background:"#0d1219", border:"1px solid #232c38", borderRadius:16, overflow:"hidden", marginTop:8, marginBottom:24 }}>
        {/* header */}
        <div style={{ background:`linear-gradient(125deg, ${d.cb} 0%, ${d.cs} 48%, #0d1219 104%)`, padding:"16px 16px 14px", position:"relative" }}>
          <button onClick={onClose} style={{ position:"absolute", top:12, right:12, width:30, height:30, borderRadius:8, border:"1px solid rgba(255,255,255,0.25)", background:"rgba(0,0,0,0.3)", color:"#fff", fontWeight:900, cursor:"pointer" }}>✕</button>
          <div style={{ display:"flex", alignItems:"center", gap:12 }}>
            <NumberChip d={d} size={58} />
            <div>
              <div style={{ fontSize:24, fontWeight:900, fontStyle:"italic", letterSpacing:-0.5, lineHeight:1, textShadow:"0 1px 4px rgba(0,0,0,0.7)" }}>{d.name}</div>
              <div style={{ display:"flex", gap:6, marginTop:6, flexWrap:"wrap", alignItems:"center" }}>
                <Tag>#{d.car}</Tag>
                <MfrTag mfr={d.mfr} big />
                <Tag>{d.team}</Tag>
                <Tag>{d.status === "Human" ? "Human driver" : "CPU"}</Tag>
                {d.honor && <Tag gold>{d.honor}</Tag>}
              </div>
            </div>
          </div>
        </div>

        <div style={{ padding:"14px 16px 20px", fontFamily:"'Arial Narrow','Roboto Condensed',system-ui,sans-serif", color:"#e9edf2" }}>
          {/* career wins */}
          <SectionLabel>Career</SectionLabel>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:8 }}>
            <BigStat v={p.careerW} l="Career wins" big />
            <BigStat v={p.s1w} l="Season 1 wins" />
            <BigStat v={p.s2w} l="Season 2 wins" />
          </div>

          <SectionLabel>Season 2 — through Race 14</SectionLabel>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(3,1fr)", gap:8 }}>
            <BigStat v={`P${p.rank}`} l="Points rank" />
            <BigStat v={p.pts} l="Points" />
            <BigStat v={p.avg!=null?p.avg.toFixed(2):"—"} l="Avg finish" />
            <BigStat v={p.best ?? "—"} l="Best finish" />
            <BigStat v={p.worst ?? "—"} l="Worst finish" />
            <BigStat v={p.starts} l="Starts" />
            <BigStat v={p.t5} l="Top 5s" />
            <BigStat v={p.t10} l="Top 10s" />
            <BigStat v={d.sw} l="Stage wins" />
            <BigStat v={d.sp} l="Stage points" />
            <BigStat v={d.mll} l="Most-laps-led" />
            <BigStat v={p.s2w} l="Wins" />
          </div>

          <SectionLabel>Championship position by race</SectionLabel>
          <div style={{ height:150, background:"#11161e", border:"1px solid #1c242f", borderRadius:10, padding:"8px 8px 0 0" }}>
            <ResponsiveContainer width="100%" height="100%">
              <LineChart data={trend} margin={{ top:6, right:8, bottom:2, left:0 }}>
                <CartesianGrid stroke="#1b222c" vertical={false} />
                <XAxis dataKey="race" tick={{ fill:"#7b8493", fontSize:9, fontWeight:700 }} axisLine={{ stroke:"#2a333f" }} tickLine={false} interval={1} />
